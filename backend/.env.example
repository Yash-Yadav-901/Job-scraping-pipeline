# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/jobstream?retryWrites=true&w=majority

# Ingestion schedule (cron syntax) — every 30 minutes by default
INGEST_CRON=*/30 * * * *

# Max jobs to store per source
MAX_JOBS_PER_SOURCE=500

# Request timeouts (ms)
HTTP_TIMEOUT_MS=8000

# Circuit breaker thresholds
CB_ERROR_THRESHOLD=50
CB_RESET_TIMEOUT_MS=60000

# Rate limiting — requests per minute per source
RATE_LIMIT_RPM=4

# Retry config
MAX_RETRIES=4
RETRY_BASE_DELAY_MS=1000
